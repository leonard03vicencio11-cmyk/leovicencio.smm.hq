{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "leovicencio-smm-hq.vercel.app"
        }
      ],
      "destination": "https://leovicenciosmm.com/:path*",
      "permanent": true
    }
  ]
}
